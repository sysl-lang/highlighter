module sh.sysl.highlighter

/** The colour of each rendering category, as a CSS colour, for `Inline` rendering. `fallback` is
 * the colour of a category the others do not name.
 */
struct Theme
    keyword: string
    string: string
    comment: string
    number: string
    `type`: string
    function: string
    variable: string
    operator: string
    punctuation: string
    fallback: string
end Theme

/** Atom's One Dark — the default theme. */
one_dark() -> Theme = Theme("#c678dd", "#98c379", "#5c6370", "#d19a66", "#e5c07b", "#61afef", "#e06c75", "#56b6c2", "#abb2bf", "#abb2bf")

one_light() -> Theme = Theme("#a626a4", "#50a14f", "#a0a1a7", "#986801", "#c18401", "#4078f2", "#e45649", "#0184bc", "#383a42", "#383a42")

