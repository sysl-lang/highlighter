module sh.sysl.highlighter
@tests

import sysl.fs.read_bytes
import sysl.text.{Search, from_utf8, join, replace_all}

// The Scala highlighter's `RealWorldGrammarTests`, test for test: VS Code's own TextMate grammars,
// carried in `test-grammars/`, and the constructs somebody writing a page of that language types.
// An assertion names the category a token must render as and, where it matters which token, the
// exact text inside the span.

private grammar_file(name: string) -> string
    val here = __FILE__
    val cut = here.last_index_of("/sh/sysl/highlighter/").expect("this file sits under sh/sysl/highlighter")

    s"${here[0..<cut]}/test-grammars/${name}.tmLanguage.json"

private[highlighter] grammar_text(name: string) -> string = from_utf8(read_bytes(grammar_file(name)).expect(s"${name} reads")).expect(s"${name} is UTF-8")

private[highlighter] load(name: string) -> Highlighter
    from_json(grammar_text(name), Classes("hl-")) match
        Ok(h) -> h
        Err(e) -> panic(s"failed to load ${name}: ${e}")

private hi(name: string, code: string) -> string = load(name).highlight(code)

// The rendered text with every span taken out and the escaping undone: the source, if nothing was
// added or dropped.
private source_of_html(html: string) -> string = replace_all(replace_all(replace_all(replace_all(without_spans(html), "&lt;", "<"), "&gt;", ">"), "&quot;", "\""), "&amp;", "&")

// Some span carries the category.
private shows(out: string, klass: string)
    assert(out.contains(s"class=\"hl-${klass}\""), s"no hl-${klass} span in: ${out}")

// A span of the category holds exactly `text`.
private shows_on(out: string, klass: string, text: string)
    val span = s"<span class=\"hl-${klass}\">${text}</span>"

    assert(out.contains(span), s"no ${span} in: ${out}")

// --- loading ---

// Each grammar loads, and — stronger than the Scala suite asked — not one of its patterns is
// refused: every `end` naming its `begin`'s groups is compiled per match, not at load.
private loads_clean(name: string)
    val h = load(name)

    assert(h.load_warnings().len() == 0, s"${name}: ${join(h.load_warnings().view(), "; ")}")

@test("grammar loading: javascript")
load_javascript() = loads_clean("javascript")

@test("grammar loading: typescript")
load_typescript() = loads_clean("typescript")

@test("grammar loading: tsx")
load_tsx() = loads_clean("tsx")

@test("grammar loading: bash")
load_bash() = loads_clean("bash")

@test("grammar loading: python")
load_python() = loads_clean("python")

@test("grammar loading: json")
load_json() = loads_clean("json")

@test("grammar loading: yaml")
load_yaml() = loads_clean("yaml")

@test("grammar loading: html")
load_html() = loads_clean("html")

@test("grammar loading: css")
load_css() = loads_clean("css")

@test("grammar loading: go")
load_go() = loads_clean("go")

@test("grammar loading: rust")
load_rust() = loads_clean("rust")

@test("grammar loading: scala")
load_scala() = loads_clean("scala")

@test("grammar loading: xml")
load_xml() = loads_clean("xml")

// --- javascript ---

@test("javascript: single-line comment")
js_line_comment()
    shows(hi("javascript", "// hello"), "comment")

@test("javascript: block comment")
js_block_comment()
    shows(hi("javascript", "/* hello */"), "comment")

@test("javascript: import keyword")
js_import()
    shows_on(hi("javascript", "import x from \"y\""), "keyword", "import")

@test("javascript: double-quoted string")
js_double_string()
    shows_on(hi("javascript", "\"hello\""), "string", "hello")

@test("javascript: single-quoted string")
js_single_string()
    shows_on(hi("javascript", "'hello'"), "string", "hello")

@test("javascript: template literal")
js_template()
    shows(hi("javascript", "`hi ${x}`"), "string")

@test("javascript: const declaration")
js_const()
    shows_on(hi("javascript", "const x = 1"), "keyword", "const")

@test("javascript: let declaration")
js_let()
    shows_on(hi("javascript", "let x = 1"), "keyword", "let")

@test("javascript: var declaration")
js_var()
    shows_on(hi("javascript", "var x = 1"), "keyword", "var")

@test("javascript: numeric literal")
js_number()
    shows_on(hi("javascript", "const x = 42"), "number", "42")

@test("javascript: true / false / null literals")
js_literals()
    shows_on(hi("javascript", "const a = true; const b = false; const c = null;"), "variable", "true")

@test("javascript: function keyword")
js_function()
    shows_on(hi("javascript", "function f() {}"), "keyword", "function")

@test("javascript: arrow function")
js_arrow()
    shows_on(hi("javascript", "const f = () => 1"), "keyword", "const")

@test("javascript: regex literal")
js_regex()
    shows(hi("javascript", "const r = /^foo$/g"), "string")

@test("javascript: class keyword")
js_class()
    shows_on(hi("javascript", "class Foo {}"), "keyword", "class")

