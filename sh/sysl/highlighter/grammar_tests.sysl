// --- yaml ---

@test("yaml: comment")
yaml_comment()
    shows(hi("yaml", "# hello"), "comment")

// The grammar has no one pattern wrapping a bare key; the `:` after it is
// `punctuation.separator.key-value.mapping.yaml`, which is what is asserted.
@test("yaml: key")
yaml_key()
    shows(hi("yaml", "key: value"), "punctuation")

@test("yaml: string value")
yaml_string()
    shows(hi("yaml", "key: \"value\""), "string")

@test("yaml: list item")
yaml_list_item()
    shows(hi("yaml", "- item"), "punctuation")

@test("yaml: iso date — no spurious number inside `2024-03-12`")
yaml_iso_date()
    assert(!hi("yaml", "date: 2024-03-12").contains("<span class=\"hl-number\">-12</span>"))

@test("yaml: negative integer at start of value highlights as number")
yaml_negative()
    shows_on(hi("yaml", "count: -12"), "number", "-12")

// --- html ---

// `html` in `<!DOCTYPE html>` is `entity.name.tag.doctype`, which renders as `function`.
@test("html: doctype")
html_doctype()
    shows_on(hi("html", "<!DOCTYPE html>"), "function", "html")

@test("html: comment")
html_comment()
    shows(hi("html", "<!-- hi -->"), "comment")

@test("html: open tag")
html_open_tag()
    shows_on(hi("html", "<div>"), "function", "div")

@test("html: attribute")
html_attribute()
    shows_on(hi("html", "<a href=\"x\"></a>"), "function", "href")

@test("html: self-closing tag")
html_self_closing()
    shows_on(hi("html", "<img src=\"x\" />"), "function", "img")

