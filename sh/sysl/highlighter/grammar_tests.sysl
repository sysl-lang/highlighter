@test("css: class selector")
css_class()
    shows_on(hi("css", ".foo { color: red }"), "function", "foo")

@test("css: property")
css_property()
    shows_on(hi("css", ".x { color: red }"), "type", "color")

// `constant.other.color.rgb-value.hex.css` holds no `numeric`, so it is a `variable`.
@test("css: color value")
css_colour()
    shows_on(hi("css", ".x { color: #ff0000 }"), "variable", "ff0000")

@test("css: @media rule")
css_media()
    shows_on(hi("css", "@media (min-width: 600px) {}"), "keyword", "media")

