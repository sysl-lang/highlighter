// --- xml: Atom's grammar nests stray `end` and `name` keys inside a `captures` object ---

@test("xml: grammar loads with no compile warnings despite malformed captures block")
xml_loads()
    assert_eq(load("xml").load_warnings().len(), 0)

@test("xml: open tag name highlights")
xml_open_tag()
    shows_on(hi("xml", "<link>"), "function", "link")

@test("xml: attribute name highlights")
xml_attribute()
    shows_on(hi("xml", "<a href=\"x\"/>"), "function", "href")

@test("xml: attribute string value highlights")
xml_attribute_value()
    shows_on(hi("xml", "<a href=\"x\"/>"), "string", "x")

@test("xml: comment highlights")
xml_comment()
    shows(hi("xml", "<!-- hi -->"), "comment")

@test("xml: multi-line tag with URL attribute (the podcast-docs repro)")
xml_multiline_tag()
    val out = hi("xml", "<link rel=\"enclosure\"\n      href=\"https://echochamber.example/audio/ep04.mp3\"/>")

    shows_on(out, "function", "link")
    shows_on(out, "string", "https://echochamber.example/audio/ep04.mp3")

// The namespace patterns' `((:))` puts two groups over one colon; the colon is written once.
@test("xml: namespaced tag does not duplicate the colon")
xml_namespaced_tag()
    assert_eq(source_of_html(hi("xml", "<atom:link href=\"x\"/>")), "<atom:link href=\"x\"/>")

@test("xml: namespaced attribute does not duplicate the colon")
xml_namespaced_attribute()
    assert_eq(source_of_html(hi("xml", "<a xmlns:atom=\"x\"/>")), "<a xmlns:atom=\"x\"/>")

// --- the regex surface: one grammar per feature ---

private synth(pattern: string) -> Highlighter
    val g = s"{ \"scopeName\": \"source.synth\", \"patterns\": [ { \"match\": ${json_string(pattern)}, \"name\": \"keyword.synth\" } ] }"

    from_json(g, Classes("hl-")).expect(s"synth grammar loads: ${pattern}")

private json_string(s: string) -> string = "\"" + replace_all(replace_all(s, "\\", "\\\\"), "\"", "\\\"") + "\""

@test("regex: negative lookbehind")
rx_negative_lookbehind()
    shows_on(synth("(?<!\\.)\\bfoo\\b").highlight("foo"), "keyword", "foo")

@test("regex: positive lookbehind")
rx_positive_lookbehind()
    shows_on(synth("(?<=\\$)\\w+").highlight("$x"), "keyword", "x")

@test("regex: negative lookahead")
rx_negative_lookahead()
    shows_on(synth("\\bfoo\\b(?!\\.)").highlight("foo"), "keyword", "foo")

@test("regex: POSIX class [:alnum:]")
rx_alnum()
    shows_on(synth("\\b[[:alnum:]]+\\b").highlight("hello"), "keyword", "hello")

@test("regex: POSIX class [:alpha:]")
rx_alpha()
    shows_on(synth("\\b[[:alpha:]]+\\b").highlight("hello"), "keyword", "hello")

@test("regex: POSIX class inside complex set [_$[:alnum:]]")
rx_complex_set()
    shows_on(synth("\\b[_$[:alnum:]]+\\b").highlight("a_b"), "keyword", "a_b")

@test("regex: atomic group")
rx_atomic()
    shows_on(synth("(?>foo)").highlight("foo"), "keyword", "foo")

@test("regex: possessive quantifier *+")
rx_possessive()
    shows_on(synth("f.*+").highlight("foo"), "keyword", "foo")

@test("regex: end-of-line anchor mid-string")
rx_end_of_line()
    shows_on(synth("[^\\n]+$").highlight("hello"), "keyword", "hello")

@test("regex: alternation")
rx_alternation()
    shows_on(synth("\\b(if|else|while)\\b").highlight("if"), "keyword", "if")

@test("regex: captures + named scope")
rx_captures()
    val g = raw"""
        {
          "scopeName": "source.synth",
          "patterns": [
            { "match": "\\b(if)\\s+(\\w+)",
              "captures": { "1": { "name": "keyword.control" }, "2": { "name": "variable.other" } } }
          ]
        }
        """
    val out = from_json(g, Classes("hl-")).expect("captures grammar loads").highlight("if x")

    shows_on(out, "keyword", "if")
    shows_on(out, "variable", "x")

// --- loader hardening ---

@test("loader: compile failures are exposed through load_warnings")
loader_warnings()
    val g = "{ \"scopeName\": \"source.bad\", \"patterns\": [ { \"match\": \"(unclosed\", \"name\": \"keyword.bad\" } ] }"
    val h = from_json(g, Classes("hl-")).expect("a grammar with a bad pattern still loads")

    assert(h.load_warnings().len() > 0)
    assert(join(h.load_warnings().view(), " ").contains("(unclosed"))

@test("loader: the engine accepts (?#comment) inline-comment groups")
loader_comment_group()
    val h = from_json("{ \"scopeName\": \"source.good\", \"patterns\": [ { \"match\": \"f(?#middle)oo\", \"name\": \"keyword.good\" } ] }", Classes("hl-")).expect("the grammar loads")

    assert_eq(h.load_warnings().len(), 0)
    shows_on(h.highlight("foo"), "keyword", "foo")

@test("loader: the engine handles a literal { without breaking quantifiers")
loader_literal_brace()
    val g = raw"""
        {
          "scopeName": "source.good",
          "patterns": [
            { "match": "a{3}", "name": "keyword.good" },
            { "match": "\\{x\\}", "name": "string.good" }
          ]
        }
        """
    val h = from_json(g, Classes("hl-")).expect("the grammar loads")

    assert_eq(h.load_warnings().len(), 0)
    shows_on(h.highlight("aaa"), "keyword", "aaa")
    shows_on(h.highlight("{x}"), "string", "{x}")

@test("loader: tolerates stray non-capture keys inside a captures object")
loader_stray_keys()
    val g = raw"""
        {
          "scopeName": "source.strays",
          "patterns": [
            {
              "begin": "<!--",
              "end": "-->",
              "name": "comment.block.strays",
              "captures": {
                "0": { "name": "punctuation.definition.comment.strays" },
                "end": "-->",
                "name": "comment.block.strays"
              }
            }
          ]
        }
        """
    val h = from_json(g, Classes("hl-")).expect("a grammar with stray captures keys still loads")

    assert_eq(h.load_warnings().len(), 0)
    shows(h.highlight("<!-- hi -->"), "comment")

@test("loader: load_warnings is empty when every pattern compiles")
loader_no_warnings()
    val h = from_json("{ \"scopeName\": \"source.good\", \"patterns\": [ { \"match\": \"\\\\bfoo\\\\b\", \"name\": \"keyword.good\" } ] }", Classes("hl-")).expect("the grammar loads")

    assert_eq(h.load_warnings().len(), 0)
