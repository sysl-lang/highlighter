@test("bash: single-quoted string")
bash_single_string()
    shows(hi("bash", "x='hello'"), "string")

// A zero-length `begin` whose pair has a zero-length `end` once held the tokenizer at one position
// for ever on exactly these two lines.
@test("bash: variable expansion inside string")
bash_expansion()
    shows(hi("bash", "echo \"$HOME\""), "variable")

@test("bash: if keyword")
bash_if()
    shows_on(hi("bash", "if true; then echo y; fi"), "keyword", "if")

@test("bash: for keyword")
bash_for()
    shows_on(hi("bash", "for i in 1 2 3; do echo $i; done"), "keyword", "for")

