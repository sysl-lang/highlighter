module sh.sysl.highlighter

import sh.sysl.oniguruma.{Match, Regex, Scanner, compile, describe, scanner}
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.text.{Search, StrBuilder, split, str_builder, to_lower, to_upper}

// Cutting text into tokens, line by line, with a stack of the `begin`/`end` pairs still open
// carried from one line to the next — the algorithm of vscode-textmate, the tokenizer every one of
// these grammars is written and tested against in Visual Studio Code.
//
// **At each position the next thing to happen is whichever matches first**: the open pair's `end`,
// or the earliest of the rules in force there, the lower-numbered rule winning a tie and the `end`
// winning a tie with any rule (losing it, under `applyEndPatternLast`). All the rules in force are
// searched as one Oniguruma regset, which answers exactly that — the leftmost match and, at that
// position, the lowest index.
//
// **A line is matched with its newline**, since grammars close rules on `\n` — `(?=;|&|\n)`, a Python
// string's `(\2)|(\n)` — and the newline is cut off the tokens afterwards.
//
// **`\G` holds where the last `begin` match ended**, goes back to what it was when that pair closes,
// and holds nowhere at the start of a line — unless the open pair's `begin` match ran to the end of
// the line before, when it holds at the new line's start.
//
// **Every offset is a byte offset into the UTF-8 line**, which is what Oniguruma answers in.

/** A piece of a line and the scopes it sits in, outermost first — the grammar's own scope, then one
 * per enclosing rule and capture. Its innermost scope is the last.
 */
struct Token
    text: string
    scopes: Buf[string]

// One open `begin`/`end` pair, the grammar itself at the bottom of the stack, or a capture whose
// text is being tokenized again.
private struct Frame
    // The rules in force inside, and the pair's identity.
    key: string

    end: Option[&Regex]
    end_captures: Option[Buf[Capture]]
    end_last: bool

    // The scopes of the pair's own delimiters, and of the text between them — the same, with the
    // `contentName` added.
    scopes: Buf[string]
    content: Buf[string]

    // Where on its line the pair was entered, and where `\G` held then; both forgotten at a new line.
    enter: usize
    anchor: usize

    // The `begin` match ran to the end of its line.
    eol: bool

// A position no search starts at, for "nowhere".
private no_pos() -> usize = ~usize(0)

// The rules in force under one key, as matched: every `$self` marker expanded, and searched as one
// scanner. `sc` is `None` only where the set would not build, and then the rules are searched one by
// one, which answers the same.
private[highlighter] struct Scan
    rules: Buf[Rule]
    sc: Option[&Scanner]

// The tokens of one line as they are produced: each one runs from where the last ended.
private struct Producer
    tokens: Buf[Token]
    last: usize

    // The text from the last token's end to `end`, under `scopes`. Nothing where `end` is not past it.
    produce(*self, line: string, scopes: Buf[string], end: usize)
        if end <= self.last then return

        self.tokens.push(Token(line[self.last..<end], scopes))
        self.last = end

private[highlighter] struct Tokenizer
    scope_name: string
    top: Buf[Rule]
    lists: Map[string, Buf[Rule]]
    warnings: Buf[string]
    scans: Map[string, Scan]
    ends: Map[string, Option[&Regex]]

    tokenize(self, text: string) -> Buf[Buf[Token]]
        var out: Buf[Buf[Token]] = buf()
        var stack: Buf[Frame] = buf()
        var root: Buf[string] = buf()

        root.push(self.scope_name)
        stack.push(Frame("$top", None, None, false, root, root, no_pos(), no_pos(), false))

        for line in split(text, "\n")
            // What a pair remembers of the line it was entered on means nothing on this one.
            for i in 0..<stack.len()
                var f = stack[i]

                f.enter = no_pos()
                f.anchor = no_pos()
                stack[i] = f

            val anchor = if stack[stack.len() - 1].eol then 0 else no_pos()
            var p = Producer(buf(), 0)

            self.run(line + "\n", stack, 0, anchor, &p)
            out.push(clip(p.tokens, line.len))

        out
    end tokenize

    // Tokens from `pos` to the end of `line`, under `stack`, which is left as the line leaves it.
    private run(self, line: string, stack: Buf[Frame], start: usize, first_anchor: usize, out: *Producer)
        var pos = start
        var anchor = first_anchor

        // Steps taken without moving. Every step that does not move pushes a pair not already open
        // at this position, or closes one entered before it, so the count is bounded by the grammar;
        // this stops a grammar that defeats that reasoning anyway.
        var stalled: usize = 0

        loop
            val frame = stack[stack.len() - 1]

            val step = self.next(frame, line, pos, anchor) match
                Some(s) -> s
                None ->
                    out.produce(line, frame.content, line.len)
                    return

            val m = step.1
            val advanced = m.end() > pos

            if advanced then stalled = 0 else stalled += 1

            if stalled > 10000
                out.produce(line, frame.content, line.len)
                return

            step.0 match
                None ->
                    // The pair closes.
                    out.produce(line, frame.content, m.start())
                    self.captures(line, frame.scopes, frame.end_captures, m, stack, out)
                    out.produce(line, frame.scopes, m.end())
                    stack.pop()
                    anchor = frame.anchor

                    // It opened here and closed here, having matched nothing: it stays open, its
                    // `contentName` set aside as the closing set it aside, and the rest of the line
                    // takes the pair's own scopes.
                    if !advanced && frame.enter == pos
                        var kept = frame

                        kept.content = frame.scopes
                        stack.push(kept)
                        out.produce(line, frame.scopes, line.len)
                        return
                Some(rule) ->
                    out.produce(line, frame.content, m.start())

                    val scopes = with_names(frame.content, named(rule.name, m), None)

                    if rule.is_begin
                        self.captures(line, scopes, rule.captures, m, stack, out)
                        out.produce(line, scopes, m.end())

                        val key = rule.inner_key.unwrap()
                        val end = if rule.end_refers then self.end_for(rule.end_source.unwrap(), m) else rule.end_regex
                        val content = with_names(scopes, named(rule.content_name, m), None)
                        val again = !advanced && reopens(stack, key, pos)

                        stack.push(Frame(key, end, rule.end_captures, rule.end_last, scopes, content, pos, anchor, m.end() == line.len))
                        anchor = m.end()

                        // The same pair opened again where it already was, matching nothing: it
                        // would open for ever, so it does not, and the rest of the line is plain.
                        if again
                            stack.pop()
                            out.produce(line, frame.content, line.len)
                            return
                    else
                        self.captures(line, scopes, rule.captures, m, stack, out)
                        out.produce(line, scopes, m.end())

                        // A rule that matched nothing closes the open pair, and the rest of the
                        // line takes the scopes left.
                        if !advanced
                            if stack.len() > 1 then stack.pop()

                            out.produce(line, stack[stack.len() - 1].content, line.len)
                            return

            if advanced then pos = m.end()
    end run

    // What happens next at `pos`: the open pair's `end` (`None`) or the rule that matched, and the
    // match.
    private next(self, frame: Frame, line: string, pos: usize, anchor: usize) -> Option[(Option[Rule], Match)]
        val em = frame.end match
            Some(er) -> search(er, line, pos, anchor)
            None -> None

        val best = next_rule(self.scan_for(frame.key), line, pos, anchor)

        em match
            Some(e) ->
                best match
                    Some((r, bm)) ->
                        val end_wins = if frame.end_last then e.start() < bm.start() else e.start() <= bm.start()

                        if end_wins then Some((None, e)) else Some((Some(r), bm))
                    None -> Some((None, e))
            None ->
                best match
                    Some((r, bm)) -> Some((Some(r), bm))
                    None -> None
    end next

    // The tokens of a match's named groups, vscode-textmate's `handleCaptures`: each group's text
    // takes its scope over the scopes of the groups around it, and a group with `patterns` has its
    // text tokenized again with those rules.
    private captures(self, line: string, base: Buf[string], caps: Option[Buf[Capture]], m: Match, stack: Buf[Frame], out: *Producer)
        val cs = caps match
            Some(cs) -> cs
            None -> return

        if cs.len() == 0 then return

        // The groups still open: their scopes and where they end.
        var open: Buf[(Buf[string], usize)] = buf()

        for i in 0..<m.group_count()
            val c = capture_for(cs, i) match
                Some(c) -> c
                None -> continue

            val span = m.span(i) match
                Some(s) -> s
                None -> continue

            val gs = span.0
            val ge = span.1

            if ge == gs then continue
            if gs > m.end() then break

            while open.len() > 0 && open[open.len() - 1].1 <= gs
                val top = open.pop().unwrap()

                out.produce(line, top.0, top.1)

            val around = if open.len() > 0 then open[open.len() - 1].0 else base

            out.produce(line, around, gs)

            c.patterns match
                Some(_) ->
                    val scopes = with_names(base, named(c.name, m), None)
                    val content = with_names(scopes, named(c.content_name, m), None)
                    var inner: Buf[Frame] = buf()

                    for f in stack.view()
                        inner.push(f)

                    inner.push(Frame(capture_key(c), None, None, false, scopes, content, gs, no_pos(), false))
                    self.run(line[0..<ge], inner, gs, no_pos(), out)
                None ->
                    named(c.name, m) match
                        Some(n) -> open.push((with_names(around, Some(n), None), ge))
                        None -> ()

        while open.len() > 0
            val top = open.pop().unwrap()

            out.produce(line, top.0, top.1)
    end captures

    private scan_for(self, key: string) -> Scan
        self.scans.get(key) match
            Some(s) -> return s
            None -> ()

        var rules: Buf[Rule] = buf()

        if key == "$top"
            push_live(rules, self.top)
        else
            self.lists.get(key) match
                Some(inner) ->
                    for r in inner.view()
                        if r.is_self then push_live(rules, self.top) else rules.push(r)
                None -> ()

        var sources: Buf[string] = buf()

        for r in rules.view()
            sources.push(r.source)

        val sc = scanner(sources.view()) match
            Ok(s) -> Some(s)
            Err(_) -> None

        val s = Scan(rules, sc)

        self.scans.put(key, s)
        s
    end scan_for

    // The `end` of a rule whose `end` names its `begin` match's groups: each `\N` replaced by the
    // text group N took, escaped, as vscode-textmate does. Compiled once per distinct result.
    private end_for(self, src: string, m: Match) -> Option[&Regex]
        val resolved = resolve_back_references(src, m)

        self.ends.get(resolved) match
            Some(r) -> return r
            None -> ()

        val r = compile(resolved) match
            Ok(re) -> Some(re)
            Err(e) ->
                self.warnings.push(s"regex compile failed: ${resolved} — ${describe(e)}")
                None

        self.ends.put(resolved, r)
        r
    end end_for
end Tokenizer

private[highlighter] tokenizer(g: Grammar) -> Tokenizer
    val r = resolve(g)

    Tokenizer(g.scope_name, r.top, r.lists, r.warnings, map(), map())

// Whether the pair `key` is already open at `pos` — among the pairs on top of the stack that were
// all entered there.
private reopens(stack: Buf[Frame], key: string, pos: usize) -> bool
    var i = stack.len()

    while i > 0 && stack[i - 1].enter == pos
        if stack[i - 1].key == key then return true

        i -= 1

    false

// The capture a group number has, if any.
private capture_for(cs: Buf[Capture], n: usize) -> Option[Capture]
    for c in cs.view()
        if group_number(c.key) == Some(n) then return Some(c)

    None

// The tokens of the first `n` bytes: a token starting at or past `n` is dropped and one running past
// it is cut there.
private clip(tokens: Buf[Token], n: usize) -> Buf[Token]
    var out: Buf[Token] = buf()
    var at: usize = 0

    for t in tokens.view()
        val len = t.text.len

        if at >= n then break

        if at + len > n then out.push(Token(t.text[0..<n - at], t.scopes)) else out.push(t)

        at += len

    out
end clip

// Every rule of `rules` but the `$self` markers.
private push_live(out: Buf[Rule], rules: Buf[Rule])
    for r in rules.view()
        if !r.is_self then out.push(r)

private search(re: &Regex, line: string, pos: usize, anchor: usize) -> Option[Match]
    re.search(line, pos, anchor) match
        Ok(m) -> m
        Err(_) -> None

// The earliest match of any rule in force at or after `pos`, the lower index winning a tie.
private next_rule(scan: Scan, line: string, pos: usize, anchor: usize) -> Option[(Rule, Match)]
    scan.sc match
        Some(sc) ->
            sc.find_next(line, pos, anchor) match
                Ok(Some(sm)) -> return Some((scan.rules[sm.index], sm.found))
                Ok(None) -> return None
                Err(_) -> ()
        None -> ()

    // One by one, which is what the set answers when it can build and search.
    var best: Option[(Rule, Match)] = None

    for r in scan.rules.view()
        r.regex match
            Some(re) ->
                search(re, line, pos, anchor) match
                    Some(m) ->
                        val better = best match
                            Some((_, bm)) -> m.start() < bm.start()
                            None -> true

                        if better then best = Some((r, m))
                    None -> ()
            None -> ()

    best
end next_rule

// A fresh list: `base`, then the scopes of `a` and of `b` where present.
private with_names(base: Buf[string], a: Option[string], b: Option[string]) -> Buf[string]
    var out: Buf[string] = buf()

    for s in base.view()
        out.push(s)

    push_scopes(out, a)
    push_scopes(out, b)
    out

// A name's scopes onto `out`. **A name may hold several, separated by spaces** — JSON's object keys
// are `string.json support.type.property-name.json` — and each is a scope of its own, the last the
// innermost.
private push_scopes(out: Buf[string], name: Option[string])
    val s = name match
        Some(s) -> s
        None -> return

    val b = s.bytes
    var from: usize = 0

    for i in 0..(b.len)
        if i == b.len || b[i] == u8(' ')
            if i > from then out.push(s[from..<i])
            from = i + 1
end push_scopes

// A name with each `$N` replaced by the text group N of `m` took, leading dots dropped, and each
// `${N:/downcase}` or `${N:/upcase}` the same text in that case — vscode-textmate's
// `replaceCaptures`. A group that took no part stands as nothing; a number past the pattern's groups
// is left as written.
private named(name: Option[string], m: Match) -> Option[string]
    val s = name match
        Some(s) -> s
        None -> return None

    if !s.contains("$") then return name

    val b = s.bytes
    var out = str_builder()
    var lit: usize = 0
    var i: usize = 0

    while i < b.len
        if b[i] != u8('$') || i + 1 >= b.len
            i += 1
            continue

        var j = i + 1
        var braced = false

        if b[j] == u8('{')
            braced = true
            j += 1

        var n: usize = 0
        val digits = j

        while j < b.len && is_digit(b[j])
            n = n * 10 + usize(b[j] - u8('0'))
            j += 1

        if j == digits
            i += 1
            continue

        var change = ""

        if braced
            val rest = s[j..]

            if rest.starts_with(":/downcase}")
                change = "down"
                j += 11
            else if rest.starts_with(":/upcase}")
                change = "up"
                j += 9
            else
                i += 1
                continue

        if n < m.group_count()
            var t = m.group(n).unwrap_or("")

            while t.starts_with(".")
                t = t[1..]

            if change == "down" then t = to_lower(t)
            if change == "up" then t = to_upper(t)

            out.push(s[lit..<i])
            out.push(t)
            lit = j

        i = j

    out.push(s[lit..])
    Some(out.finish())
end named

private[highlighter] same_scopes(a: Buf[string], b: Buf[string]) -> bool
    if a.len() != b.len() then return false

    for i in 0..<a.len()
        if a[i] != b[i] then return false

    true

// A capture key read as a group number: digits, as the key was written.
private group_number(key: string) -> Option[usize]
    val b = key.bytes

    if b.len == 0 then return None

    var n: usize = 0

    for c in b
        if !is_digit(c) then return None

        n = n * 10 + usize(c - u8('0'))

    Some(n)
end group_number

// An `end` pattern with each `\N` replaced by the text group N of the `begin` match took — nothing
// where the group took no part — with every character that means something in a pattern escaped.
// vscode-textmate's `resolveBackReferences` and `escapeRegExpCharacters`.
private[highlighter] resolve_back_references(src: string, m: Match) -> string
    val b = src.bytes
    var out = str_builder()
    var i: usize = 0
    var lit = i

    while i < b.len
        if b[i] == u8('\\') && i + 1 < b.len && is_digit(b[i + 1])
            out.push(src[lit..<i])

            var j = i + 1
            var n: usize = 0

            while j < b.len && is_digit(b[j])
                n = n * 10 + usize(b[j] - u8('0'))
                j += 1

            m.group(n) match
                Some(g) -> push_escaped(&out, g)
                None -> ()

            i = j
            lit = j
        else
            i += 1

    out.push(src[lit..])
    out.finish()
end resolve_back_references

private push_escaped(out: *StrBuilder, s: string)
    val b = s.bytes
    var lit: usize = 0

    for i in 0..<b.len
        if needs_escape(b[i])
            out.push(s[lit..<i])
            out.push("\\")
            lit = i

    out.push(s[lit..])

private needs_escape(c: u8) -> bool = c == u8('-') || c == u8('\\') || c == u8('{') || c == u8('}') || c == u8('*') || c == u8('+') || c == u8('?') || c == u8('|') || c == u8('^') || c == u8('$') || c == u8('.') || c == u8(',') || c == u8('[') || c == u8(']') || c == u8('(') || c == u8(')') || c == u8('#') || c == u8(' ') || (c >= 9 && c <= 13)
