// Syntax highlighting driven by TextMate grammars, for sysl.
//
// This is the block a consumer writes to reach it:
//
//     dependencies {
//       highlighter { git = "github.com/sysl-lang/highlighter", version = "0.1.1" }
//     }
//
// The module a program imports is `sh.sysl.highlighter`.
package {
  name    = "highlighter"
  version = "0.1.1"

  // The compiler this was written and tested against.
  sysl = "0.1.0-alpha.4"
}

dependencies {
  oniguruma { git = "github.com/sysl-lang/oniguruma", version = "0.1.0" }
  json      { git = "github.com/sysl-lang/json", version = "0.2.1" }
}

// The composition with Markdown is checked by the suite and costs a consumer nothing: a program that
// renders Markdown names both packages itself.
dev_dependencies {
  markdown { git = "github.com/sysl-lang/markdown", version = "0.2.1" }
}

// **`heap`**, because a grammar's rules, a line's tokens and the HTML are all sized by the input.
// **`posix`** comes with Oniguruma, a hosted library. **Not `os`**: nothing here opens a file — a
// grammar is handed over as the text the caller already read.
requires {
  heap  = true
  posix = true
}
